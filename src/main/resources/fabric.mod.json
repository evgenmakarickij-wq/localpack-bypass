{
  "schemaVersion": 1,
  "id": "localpack-bypass",
  "version": "${version}",
  "name": "Local Resource Pack Cache",
  "description": "Downloads server resource packs with one button, saves them to resourcepacks and enables them automatically. If a pack is already downloaded, you join without any prompts.",
  "authors": [
    "McChopik",
    "Telemine3140"
  ],
  "contact": {
    "homepage": "https://github.com/evgenmakarickij-wq/localpack-bypass",
    "issues": "https://github.com/evgenmakarickij-wq/localpack-bypass/issues",
    "sources": "https://github.com/evgenmakarickij-wq/localpack-bypass"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.localpack.bypass.LocalPackBypassClient"
    ],
    "modmenu": [
      "com.localpack.bypass.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "localpack-bypass.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "~1.21.10",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  }
}
